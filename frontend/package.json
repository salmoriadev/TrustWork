{
  "name": "trustwork-web",
  "version": "0.1.0",
  "description": "TrustWork portfolio frontend for Base Sepolia milestone escrow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salmoriadev/TrustWork.git",
    "directory": "frontend"
  },
  "engines": {
    "node": ">=20.19 <21",
    "npm": ">=10"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build --mode ci",
    "build:staging": "tsc && vite build --mode staging",
    "build:production": "tsc && vite build --mode production",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun --config=./lighthouserc.json",
    "api:generate": "openapi-typescript ../backend/openapi.json -o src/lib/api.generated.ts"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "^2.23.10",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "axios": "^1.18.0"
  }
}
